# ============================================================================
# Optimized Multi-stage Dockerfile for Elizabeth (Rust + Embedded SPA)
# ============================================================================
# Single binary: Rust backend + Next.js SPA embedded via rust-embed
# ============================================================================

# ----------------------------------------------------------------------------
# Stage 1: Frontend Builder - Build Next.js SPA static export
# ----------------------------------------------------------------------------
FROM oven/bun:1-alpine AS frontend-builder

WORKDIR /app/web

# Copy web package files
COPY web/package.json web/bun.lockb* ./

# Install dependencies
RUN bun install --frozen-lockfile

# Copy web source
COPY web/ ./

# Build static export (output: 'export' in next.config.mjs when NODE_ENV=production)
RUN NODE_ENV=production bun run build

# ----------------------------------------------------------------------------
# Stage 2: Chef Base - Setup cargo-chef for optimized dependency caching
# ----------------------------------------------------------------------------
FROM lukemathwalker/cargo-chef:latest AS chef

WORKDIR /app

# Copy manifest files for dependency analysis
COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./
COPY crates/ ./crates/

# Generate build recipe (analyzes dependencies without building)
RUN cargo chef prepare --recipe-path recipe.json

# ----------------------------------------------------------------------------
# Stage 3: Builder - Build dependencies and application
# ----------------------------------------------------------------------------
FROM chef AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    sqlite3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Configure Cargo network settings to fix IPv6/SSL issues
# See: https://doc.rust-lang.org/cargo/reference/config.html
ENV CARGO_HTTP_MULTIPLEXING=false
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=git

# Copy recipe from planner
COPY --from=chef /app/recipe.json recipe.json

# Build dependencies (cached unless dependencies change)
RUN cargo chef cook --release --recipe-path recipe.json

# Copy source code
COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./
COPY crates/ ./crates/

# Copy built frontend (needed by rust-embed at compile time)
COPY --from=frontend-builder /app/web/out ./crates/board/web-out

# Build the application (rust-embed will embed web/out/ into the binary)
RUN cargo build --release -p elizabeth-board

# ----------------------------------------------------------------------------
# Stage 4: Runtime tree - writable directories for the distroless runtime
# ----------------------------------------------------------------------------
# The distroless runtime has no shell, so it cannot create or chown anything at
# build time. Lay the writable tree out here and copy it in with its final owner.
# 65532 is the `nonroot` user that the runtime image already ships.
FROM builder AS runtime-tree

RUN install -d -m 0750 -o 65532 -g 65532 /runtime/data /runtime/storage/rooms

# ----------------------------------------------------------------------------
# Stage 5: Runtime - Minimal distroless image
# ----------------------------------------------------------------------------
# NOTE: The cargo-chef base image is built against glibc >= 2.38.
# Debian bookworm ships glibc 2.36, which will fail at runtime with:
#   `GLIBC_2.38' not found
# `cc-debian13` is Debian 13 (glibc 2.41) and satisfies that requirement.
#
# It is used instead of `debian:trixie-slim` because it ships only the C runtime
# (glibc, libgcc, ca-certificates, tzdata) and no userland: no shell, no package
# manager, no perl, no util-linux, no curl. A full Debian userland carries base
# image CVEs that this application never executes, and the shell is exactly what
# an attacker wants after a foothold.
#
# Consequences to keep in mind when editing this file:
# - There is no shell, so no `RUN` and no `CMD-SHELL` healthcheck. The container
#   healthcheck calls `board health`, which probes the API in-process.
# - There is no `sqlite3` CLI. Inspect the database from the host against the
#   mounted data directory instead.
# - The digest is pinned so the runtime cannot drift underneath a release;
#   Dependabot bumps it (see `.github/dependabot.yml`).
FROM gcr.io/distroless/cc-debian13:nonroot@sha256:54df941ed0d06a1bd95ef5e0ce391fd8d9f94b64782dc9a60062727849ee3f97 AS runtime

WORKDIR /app

# Copy the compiled binary and migrations from builder
COPY --from=builder /app/target/release/board /app/board
COPY --from=builder /app/crates/board/migrations /app/migrations/
COPY --from=builder /app/crates/board/migrations_pg /app/migrations_pg/
COPY docker/backend/config/backend.yaml /app/config/backend.yaml

# Writable state, owned by the `nonroot` user the image runs as. Compose
# deployments bind-mount over both paths; these copies keep the image usable
# stand-alone.
COPY --from=runtime-tree --chown=65532:65532 /runtime/data /app/data
COPY --from=runtime-tree --chown=65532:65532 /runtime/storage /app/storage

# Expose single application port (serves both API and embedded SPA)
EXPOSE 4092

# Default log level for the `logrs` subscriber. `RUST_LOG` accepts per-target
# directives and is read directly, so this is only the baseline.
ENV RUST_LOG=info

# Healthcheck in exec form. `docker run --health-cmd` always wraps its argument in
# `/bin/sh -c`, and this image has no shell, so the probe has to be declared here
# with the JSON form. `board health` dials the API in-process instead of shelling
# out to `curl`. Compose deployments override this with an equivalent entry.
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=10s \
  CMD ["/app/board", "health", "--config-file", "/app/config/backend.yaml"]

# NOTE: the default database URL deliberately lives in `config/backend.yaml` only.
# Baking it as an `ENV` here would be applied after the `ELIZABETH__APP__*`
# environment source and would therefore silently shadow
# `ELIZABETH__APP__DATABASE__URL`.

# Run the application
ENTRYPOINT ["/app/board"]
CMD ["run", "--config-file", "/app/config/backend.yaml"]
