# ============================================================================
# Elizabeth Docker Environment Configuration
# ============================================================================
# Copy this file to `.env` and customize it for your deployment:
#
#   cp .env.docker .env
#
# Every environment variable the backend reads is listed below. Active entries
# form this deployment's profile; commented entries are optional and show the
# value that is used when they are left unset. Docker Compose forwards all of
# them (`docker-compose.yml`), so uncommenting a line is enough to take effect.
#
# Values annotated "（内置默认 X；此处 Y 是本部署档位）" differ from the compiled-in
# default in `crates/configrs/src/configs/app.rs`; the difference is intentional
# and is described inline.

# ----------------------------------------------------------------------------
# Port Configuration
# ----------------------------------------------------------------------------
BACKEND_PORT=4092

# ----------------------------------------------------------------------------
# Platform Admin（管理面板 /admin）
# ----------------------------------------------------------------------------
# 仅在数据库尚无管理员账号时用于 bootstrap；之后改密走管理面板并持久化到数据库。
# 不设置（留空）则管理面板保持关闭。密码至少 12 个字符且不含空白。
#ELIZABETH_ADMIN_USERNAME=admin
#ELIZABETH_ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# Host Bind Mounts (optional)
# ----------------------------------------------------------------------------
# Override these if you want to store DB/files outside the repo directory.
# Examples:
#   ELIZABETH_DATA_DIR=/var/lib/elizabeth/data
#   ELIZABETH_STORAGE_DIR=/var/lib/elizabeth/storage
#   ELIZABETH_BACKEND_CONFIG=/etc/elizabeth/backend.yaml
ELIZABETH_DATA_DIR=./docker/backend/data
ELIZABETH_STORAGE_DIR=./docker/backend/storage
ELIZABETH_BACKEND_CONFIG=./docker/backend/config/backend.yaml

# ----------------------------------------------------------------------------
# Container Identity
# ----------------------------------------------------------------------------
# 镜像以 distroless `nonroot`（uid/gid 65532）运行，且没有 shell。Linux 上 bind
# mount 保留宿主机属主，所以首次启动前要把上面两个目录交给这个用户：
#   ./scripts/docker_prepare_volumes.sh
# 该脚本会创建目录并在 Linux 上执行 chown；Docker Desktop（macOS / Windows）会虚拟化
# bind mount 属主，无需 chown。
# 只有在你确实想换一个身份时才改下面两项；0 表示以 root 运行（打包版本从不这样做）。
#ELIZABETH_UID=65532
#ELIZABETH_GID=65532

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
# 日志级别：off, error, warn, info, debug, trace
LOG_LEVEL=info

# RUST_LOG 优先于 LOG_LEVEL，并支持按模块指定指令。示例：
#   RUST_LOG=warn,board=debug,sqlx=info
RUST_LOG=info

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# 默认 SQLite（文件位于 /app/data）。改成 PostgreSQL 只需换连接串，协议决定驱动与
# migrations：
#   DATABASE_URL=postgresql://用户名:密码@主机名:端口/数据库名
DATABASE_URL=sqlite:///app/data/elizabeth.db

# 连接池上限。SQLite 并发写入能力有限，连接池不宜过大。
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1

# 遗留变量：仅当 DATABASE_URL 未设置时才作为回退读取。本 Compose 始终定义
# DATABASE_URL，因此在容器内它永远不生效——请改用 DATABASE_URL。
#DATABASE_PATH=/app/data/elizabeth.db

# Optional PostgreSQL settings (used by docker-compose.postgres.yml)
# POSTGRES_DB=elizabeth
# POSTGRES_USER=elizabeth
# IMPORTANT: Change this in production
# POSTGRES_PASSWORD=please-change-me # pragma: allowlist secret

# ----------------------------------------------------------------------------
# JWT Configuration
# ----------------------------------------------------------------------------
# IMPORTANT: Change this in production! Must be at least 32 characters
JWT_SECRET=please-change-this-secret-in-production-min-32-chars-long-for-security # pragma: allowlist secret

# JWT token time-to-live in seconds（内置默认 1800；此处 7200 是本部署档位）
JWT_TTL_SECONDS=7200

# JWT leeway in seconds for clock skew (default: 5 seconds)
JWT_LEEWAY_SECONDS=5

# Refresh token time-to-live in seconds (default: 7 days)
JWT_REFRESH_TTL_SECONDS=604800

# Cleanup interval for expired tokens in seconds (default: 24 hours)
JWT_CLEANUP_INTERVAL_SECONDS=86400

# Enable refresh token rotation for enhanced security
JWT_ENABLE_REFRESH_TOKEN_ROTATION=true

# ----------------------------------------------------------------------------
# Room Configuration
# ----------------------------------------------------------------------------
# Maximum room content size. Supports raw bytes and human-readable SI/IEC units.
# Examples: 50M / 100MB / 1G (decimal), 50MiB / 1GiB (binary).
# 50MiB is exactly equal to the previous default value 52428800 bytes.
ROOM_MAX_SIZE=50MiB

# Maximum number of times a room can be entered
ROOM_MAX_TIMES_ENTERED=100

# 新房间默认密码；留空表示无密码
ROOM_DEFAULT_PASSWORD=

# 新房间默认加入角色：admin / editor / reader。
# 这是房间权限的唯一默认值来源；旧版本文档里的 ROOM_DEFAULT_PERMISSION_* 已随权限
# 重构删除，后端不再读取。
ROOM_DEFAULT_ROLE=reader

# Allowed room expiry ages exposed to the UI and validated by the backend.
# Comma-separated humantime values. 必须严格升序且不含重复值。
ROOM_ALLOWED_AGES=1m,30m,2h,12h,1d,7d,30d,365d

# Default room expiry age applied to newly created rooms and legacy backfill.
# 必须包含在上面的 ROOM_ALLOWED_AGES 中。
ROOM_DEFAULT_AGE=2h

# Room share-disabled lock duration. Supports humantime units such as s/m/h/d/w.
ROOM_SHARE_DISABLED_LOCK_DURATION=1h

# ----------------------------------------------------------------------------
# Upload Configuration
# ----------------------------------------------------------------------------
# Upload reservation time-to-live in seconds (default: 1 hour)
UPLOAD_RESERVATION_TTL_SECONDS=3600

# Background reconciliation interval for expired/full room cleanup.
# （内置默认 600；此处 60 是本部署档位）
GC_INTERVAL_SECONDS=60

# Maximum rooms handled in a single reconciliation pass.
GC_BATCH_LIMIT=200

# ----------------------------------------------------------------------------
# Content Storage
# ----------------------------------------------------------------------------
# `fs`（默认）把内容放在 /app/storage bind mount；`s3` 放到 S3 兼容对象存储。
# 无法识别的取值会静默回退为 `fs`。
STORAGE_BACKEND=fs

# 仅当 STORAGE_BACKEND=s3 时读取；endpoint / bucket / access key / secret 四项必填。
#STORAGE_S3_ENDPOINT=https://s3.example.com
#STORAGE_S3_BUCKET=elizabeth
#STORAGE_S3_ACCESS_KEY_ID=
#STORAGE_S3_SECRET_ACCESS_KEY=
# 可选；留空则由 S3 客户端自行推断。
#STORAGE_S3_REGION=

# `proxy`（默认）让所有上传下载都经服务端代理；`presigned` 由服务端鉴权后签发短时效
# 直传/直下 URL，仅 STORAGE_BACKEND=s3 时可用。
STORAGE_TRANSFER=proxy

# 预签名 URL 的自定义公网 base URL（CDN / 自定义域名）；留空则用 S3 endpoint。
#STORAGE_PRESIGN_BASE_URL=https://cdn.example.com

# 预签名 URL 有效期（秒）
STORAGE_PRESIGN_TTL_SECONDS=300

# 跨房间内容去重（共享物理对象）。默认关闭：跨房间去重构成存在性 oracle，
# 开启前请先评估隐私代价。
STORAGE_GLOBAL_DEDUP=false

# ----------------------------------------------------------------------------
# Middleware Configuration
# ----------------------------------------------------------------------------

# Tracing Middleware（内置默认 enabled=true / level=info）
MIDDLEWARE_TRACING_ENABLED=true
MIDDLEWARE_TRACING_LEVEL=info
MIDDLEWARE_TRACING_INCLUDE_HEADERS=false
MIDDLEWARE_TRACING_INCLUDE_BODY=false

# Request ID Middleware
MIDDLEWARE_REQUEST_ID_ENABLED=true
MIDDLEWARE_REQUEST_ID_HEADER_NAME=X-Request-Id
MIDDLEWARE_REQUEST_ID_GENERATE_IF_MISSING=true

# Compression Middleware（内置默认 enabled=false；容器档位开启）
MIDDLEWARE_COMPRESSION_ENABLED=true
MIDDLEWARE_COMPRESSION_MIN_CONTENT_LENGTH=1024

# CORS Middleware（内置默认 enabled=false；容器档位开启）
MIDDLEWARE_CORS_ENABLED=true
# For production, specify exact origins instead of *
MIDDLEWARE_CORS_ALLOWED_ORIGINS=*
MIDDLEWARE_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
MIDDLEWARE_CORS_ALLOWED_HEADERS=*
MIDDLEWARE_CORS_ALLOW_CREDENTIALS=false
MIDDLEWARE_CORS_MAX_AGE=3600
# 浏览器可读取的响应头，逗号分隔；留空表示不额外暴露。
#MIDDLEWARE_CORS_EXPOSE_HEADERS=

# Security Middleware
MIDDLEWARE_SECURITY_ENABLED=true
MIDDLEWARE_SECURITY_CONTENT_TYPE_OPTIONS=true
MIDDLEWARE_SECURITY_FRAME_OPTIONS=DENY
MIDDLEWARE_SECURITY_XSS_PROTECTION="1; mode=block"
MIDDLEWARE_SECURITY_STRICT_TRANSPORT_SECURITY="max-age=31536000; includeSubDomains"
MIDDLEWARE_SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
# 开启时服务 `Disallow: /` 的 robots.txt，并给 HTML 响应加 X-Robots-Tag: noindex。
# 私人分享工具默认不应被搜索引擎收录。
MIDDLEWARE_SECURITY_DISALLOW_SEARCH_INDEXING=true

# Rate Limit Middleware（内置默认 enabled=false / per_second=10 / burst=20；
# 容器档位开启并使用下面的值）
# 按客户端 IP 计数的令牌桶。需要高于前端的实际上传请求速率，否则分片上传会收到 429。
MIDDLEWARE_RATE_LIMIT_ENABLED=true
MIDDLEWARE_RATE_LIMIT_PER_SECOND=20
MIDDLEWARE_RATE_LIMIT_BURST_SIZE=40
MIDDLEWARE_RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=60
