{
  "name": "elizabeth-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bun typecheck && next build",
    "build:embedded": "bun run build && rm -rf ../crates/board/web-out && cp -r out ../crates/board/web-out",
    "dev": "next dev",
    "e2e:clean": "rimraf playwright-report target",
    "e2e:test": "playwright test",
    "e2e:report": "serenity-bdd run",
    "e2e:report:open": "mkdirp target/site/serenity && http-server -p 8080 target/site/serenity -s -o",
    "lint": "eslint . --max-warnings 0",
    "i18n:audit": "bun scripts/i18n-dead-keys.mjs",
    "e2e:audit": "bun scripts/e2e-dead-code.mjs",
    "test": "bun test lib/messages",
    "typecheck": "tsc --noEmit",
    "start": "next start"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@serenity-js/console-reporter": "^3.49.0",
    "@serenity-js/core": "^3.49.0",
    "@serenity-js/playwright": "^3.49.0",
    "@serenity-js/playwright-test": "^3.49.0",
    "@serenity-js/serenity-bdd": "^3.49.0",
    "@serenity-js/web": "^3.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "^11.2.9",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-file-icon": "^1.6.0",
    "react-markdown": "^10.1.0",
    "react-medium-image-zoom": "^5.4.9",
    "react-pdf": "^11.0.0",
    "react-resizable-panels": "^4.15.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "simple-icons": "^16.36.0",
