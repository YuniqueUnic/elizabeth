    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "http-server": "^14.1.1",
    "mkdirp": "^3.0.1",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
